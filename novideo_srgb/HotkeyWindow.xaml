<Window x:Class="novideo_srgb.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Hotkey" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Press a key combination to toggle the sRGB clamp:" Margin="0,0,0,6" />
        <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" HorizontalContentAlignment="Center"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                 LostFocus="HotkeyBox_LostFocus" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear" Width="75" Click="ClearButton_Click" Margin="0,0,6,0" />
            <Button Content="Save" Width="75" Click="SaveButton_Click" Margin="0,0,6,0" />
            <Button Content="Cancel" Width="75" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
