<Window x:Class="novideo_srgb.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:novideo_srgb"
        mc:Ignorable="d"
        Title="Logs" Height="400" Width="600" MinHeight="200" MinWidth="350"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
        <local:NewGroupVisibilityConverter x:Key="NewGroupVisibilityConverter" />
        <CollectionViewSource x:Key="GroupedLogs">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DateLabel" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Clear" Width="75" Click="ClearButton_Click" />
            <Button Content="Export..." Width="75" Margin="6,0,0,0" Click="ExportButton_Click" />
            <TextBlock x:Name="StatsText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
        </StackPanel>
        <ListView x:Name="LogListView" ItemsSource="{Binding Source={StaticResource GroupedLogs}}"
                  ScrollViewer.ScrollChanged="LogListView_ScrollChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Margin="0,0,8,0"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,2" Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#FFEFF6FF" BorderBrush="DodgerBlue" BorderThickness="0,1,0,1"
                                    Padding="0,2" Margin="0,4"
                                    Visibility="{Binding Name, Converter={StaticResource NewGroupVisibilityConverter}}">
                                <TextBlock Text="NEW" FontWeight="Bold" Foreground="DodgerBlue"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
    </DockPanel>
</Window>
